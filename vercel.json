{
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), payment=(), usb=(), interest-cohort=(), geolocation=(self)" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
    ] },
    { "source": "/(sw\\.js|site\\.webmanifest|css/.*|js/.*|commandes/.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
    ] },
    { "source": "/commandes/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] },
    { "source": "/(assets|vendor)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/(.*)\\.webmanifest", "headers": [ { "key": "Content-Type", "value": "application/manifest+json" } ] }
  ]
}
